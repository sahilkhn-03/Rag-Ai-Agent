# Groq API Configuration
# Get your free API key from: https://console.groq.com/keys
# IMPORTANT: Do NOT commit real secrets to VCS. Use this file locally or set
# the GROQ_API_KEY environment variable in your shell before deploying.
# Example (Windows cmd):
#   set GROQ_API_KEY=your_real_groq_key_here
GROQ_API_KEY=

